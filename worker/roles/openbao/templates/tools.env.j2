# {{ ansible_managed }}
# This host's identity to every OpenBao tool. ${VAR:-value} so an explicit
# environment still wins (crunchtools/openbao README, "One image").
OPENBAO_ADDR=${OPENBAO_ADDR:-https://127.0.0.1:8200}
OPENBAO_CREDDIR=${OPENBAO_CREDDIR:-$HOME/.config/openbao}
OPENBAO_PREFIX=${OPENBAO_PREFIX:-{{ openbao_prefix }}}
OPENBAO_KVMOUNT=${OPENBAO_KVMOUNT:-kv}
SRV_CONFIG_ROOT=${SRV_CONFIG_ROOT:-$HOME/srv}
SRV_SECRETS_ROOT=${SRV_SECRETS_ROOT:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/srv-secrets}
OPENBAO_TMP=${OPENBAO_TMP:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}}
OPENBAO_SNAPSHOT_DIR=${OPENBAO_SNAPSHOT_DIR:-{{ openbao_dir }}/data/snapshots}
OPENBAO_IMAGE=${OPENBAO_IMAGE:-{{ openbao_image }}}
