# {{ ansible_managed }}
[Unit]
Description=Deliver %i secrets into the runtime dir from OpenBao
# Wants= and After=, never Requires=: this unit clears its own runtime
# directory on stop, so Requires= would make one openbao restart empty every
# service's secrets at once.
Wants=openbao.service
After=openbao.service
DefaultDependencies=no
After=basic.target
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Extracted from the openbao image by openbao-install-host.
ExecStart=/usr/bin/bash {{ openbao_dir }}/config/srv-secrets %i
ExecStopPost=/usr/bin/rm -rf %t/srv-secrets/%i

[Install]
WantedBy=default.target
