# {{ ansible_managed }}
ui = false
storage "raft" { path = "/openbao/data"
  node_id = "{{ openbao_prefix }}" }
listener "tcp" {
  address         = "127.0.0.1:8200"
  tls_cert_file   = "/openbao/tls/server.pem"
  tls_key_file    = "/openbao/tls/server.key"
  tls_min_version = "tls13"
}
seal "static" {
  current_key_id = "{{ openbao_seal_key_id }}"
  current_key    = "file:///openbao/secrets/unseal.key"
}
audit "file" "file" {
  description = "Audit log on disk."
  options { file_path = "/openbao/data/audit/audit.log" }
}
api_addr     = "https://127.0.0.1:8200"
cluster_addr = "https://127.0.0.1:8201"
